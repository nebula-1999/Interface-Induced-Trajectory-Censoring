__pycache__/
*.pyc
.venv/
.superseded/
*.log
vllm_*.log
runs/**/*.jsonl.tmp
.DS_Store

# 运行日志是产物的一部分——"22:05→22:12 全程无人工介入"这类说法的唯一凭证
# 就是这些日志。上面的 *.log 会把它们一起吞掉，这里放行；vLLM 那种几百 MB
# 的服务日志在最后一行重新排除。
# 只放行 P1/P2 这几次跑批的日志。写成 !runs/**/*.log 会把 runs/ 下上百份
# 历史诊断日志一起解除忽略，那些是之前有意排除的。
!runs/p1/*.log
!runs/p1_clean/*.log
!runs/p2/*.log
!p1/from_server_*/*.log
!p2/from_server_*/*.log
vllm_*.log

# P1 的 BFCL 产物只入不可再生的部分：result 是模型真的写出来的字节，丢了要
# 重开卡才能拿回；score 可由 result 重跑 BFCL 自带评分器再生，评分结论也已
# 记在 P1_VALIDATION.txt 与论文 §5.3 里；score.pre_reaggregate_* 是恢复前的
# 旧副本，已被取代。两者合计 68 MB，不进公开仓库的历史。本地仍保留。
runs/p1_clean/bfcl_run/*/score/
runs/p1_clean/bfcl_run/*/score.pre_reaggregate_*/

# BFCL 运行时产生的锁目录与它要求存在的空 .env：都是瞬时文件，不是产物。
# .env 尤其不该进公开仓库——名字看起来像密钥，实际是个 0 字节占位文件。
runs/**/.file_locks/
runs/**/.env

# Overleaf 上传用的打包快照：内容与 paper/ 完全重复，而且一旦 paper/ 更新它就
# 变成一份不会报错的旧论文——谁拿它去编译，编出来的是过期版本。用完即弃，不入库。
paper*.zip

# LaTeX 编译产物（main.pdf 保留，方便不装 TeX 的人直接看）
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
